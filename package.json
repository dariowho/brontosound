{
  "name": "brontosound",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dariowho/brontosound.git"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--no-network-family-autoselection vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
    "test": "npm run test:integration && npm run test:unit",
    "lint": "eslint .",
    "test:integration": "playwright test",
    "test:unit": "vitest",
    "release": "standard-version",
    "release:dry": "standard-version --dry-run",
    "update-version-file": "node scripts/update-version.js",
    "hash-password": "vite-node --root scripts scripts/hash-password.js",
    "fetch-soundfont": "vite-node --root scripts scripts/fetch-soundfont.js"
  },
  "devDependencies": {
    "@magidoc/plugin-svelte-marked": "^4.0.0",
    "@playwright/test": "^1.28.1",
    "@sveltejs/adapter-auto": "^4.0.0",
    "@sveltejs/adapter-node": "^5.2.12",
    "@sveltejs/kit": "^2.17.2",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/leaflet": "^1.9.22",
    "@types/marked": "^5.0.1",
    "@types/node": "^22.13.5",
    "autoprefixer": "^10.4.14",
    "eslint": "^8.28.0",
    "flowbite-svelte-icons": "^2.0.2",
    "marked": "^6.0.0",
    "postcss": "^8.4.24",
    "postcss-load-config": "^4.0.1",
    "standard-version": "^9.5.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.1.4",
    "tailwindcss": "^3.3.2",
    "typescript": "^5.0.0",
    "vite-node": "^3.0.6",
    "vitest": "^3.0.6"
  },
  "type": "module",
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@auth/sveltekit": "^1.8.0",
    "@beyonk/async-script-loader": "^2.3.0",
    "@beyonk/svelte-googlemaps": "^3.2.0",
    "@floating-ui/dom": "^1.4.5",
    "@fortawesome/free-brands-svg-icons": "^6.4.0",
    "@fortawesome/free-regular-svg-icons": "^6.4.0",
    "@fortawesome/free-solid-svg-icons": "^6.4.0",
    "@soundtouchjs/audio-worklet": "^2.1.1",
    "@tonejs/midi": "^2.0.28",
    "better-sqlite3": "^12.11.1",
    "chordsheetjs": "^7.17.2",
    "class-transformer": "^0.5.1",
    "flowbite": "^1.7.0",
    "flowbite-svelte": "^0.48.3",
    "leaflet": "^1.9.4",
    "pdfjs-dist": "^6.5.438",
    "reflect-metadata": "^0.2.2",
    "slugify": "^1.6.6",
    "svelte-fa": "^4.0.3",
    "svelte-tags-input": "^6.0.2",
    "tailwind-merge": "^1.14.0",
    "typeorm": "^1.1.3",
    "webdav": "^5.8.0"
  },
  "standard-version": {
    "bumpFiles": [
      "package.json",
      "package-lock.json",
      {
        "filename": "src/lib/version.json",
        "type": "json"
      }
    ],
    "scripts": {
      "precommit": "node scripts/update-version.js && git add src/lib/version.json"
    },
    "types": [
      {
        "type": "feat",
        "section": "Features"
      },
      {
        "type": "fix",
        "section": "Bug Fixes"
      },
      {
        "type": "refactor",
        "section": "Refactors"
      },
      {
        "type": "perf",
        "section": "Performance"
      },
      {
        "type": "revert",
        "section": "Reverts"
      },
      {
        "type": "docs",
        "section": "Documentation",
        "hidden": true
      },
      {
        "type": "style",
        "hidden": true
      },
      {
        "type": "chore",
        "hidden": true
      },
      {
        "type": "test",
        "hidden": true
      },
      {
        "type": "build",
        "hidden": true
      },
      {
        "type": "ci",
        "hidden": true
      }
    ]
  }
}
